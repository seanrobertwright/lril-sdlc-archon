{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["../.shared/**/*.ts", "../*/scripts/**/*.ts", "../*/bin/**/*.ts", "tests/**/*.ts"]
}
